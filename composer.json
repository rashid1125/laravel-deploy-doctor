{
  "name": "rashid1125/laravel-deploy-doctor",
  "description": "A small Artisan command that checks common Laravel deployment requirements.",
  "type": "library",
  "license": "MIT",
  "require": {
    "php": "^8.1",
    "illuminate/console": "^10.0 || ^11.0 || ^12.0",
    "illuminate/support": "^10.0 || ^11.0 || ^12.0"
  },
  "autoload": {
    "psr-4": {
      "Rashid1125\\DeployDoctor\\": "src/"
    }
  },
  "autoload-dev": {
    "psr-4": {
      "Rashid1125\\DeployDoctor\\Tests\\": "tests/"
    }
  },
  "require-dev": {
    "orchestra/testbench": "^8.0 || ^9.0 || ^10.0",
    "phpunit/phpunit": "^10.5 || ^11.0"
  },
  "scripts": {
    "test": "phpunit"
  },
  "extra": {
    "laravel": {
      "providers": [
        "Rashid1125\\DeployDoctor\\DeployDoctorServiceProvider"
      ]
    }
  },
  "config": {
    "sort-packages": true
  }
}
